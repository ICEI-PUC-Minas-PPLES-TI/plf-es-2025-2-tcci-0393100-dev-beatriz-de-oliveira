{
  "name": "admin-chatbot-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/server.js",
    "type-check": "tsc --noEmit -p tsconfig.json",
