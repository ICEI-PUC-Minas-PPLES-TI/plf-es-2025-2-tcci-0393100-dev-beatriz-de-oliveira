  },
  "dependencies": {
    "@fastify/cors": "11.1.0",
    "dotenv": "16.6.1",
    "fastify": "5.6.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/node": "24.4.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
