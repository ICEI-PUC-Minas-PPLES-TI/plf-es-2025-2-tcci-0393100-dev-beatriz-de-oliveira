{
    "name": "admin-chatbot-backend",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "dev": "tsx watch src/server/server.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server/server.js",
        "type-check": "tsc --noEmit -p tsconfig.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "smoke:billing": "tsx src/scripts/billing-routine-smoke.ts",
        "test:db": "tsx src/scripts/test-db.ts"
    },
    "dependencies": {
        "@fastify/cors": "11.1.0",
        "@fastify/swagger": "^9.7.0",
        "@fastify/swagger-ui": "^5.2.5",
        "@types/pg": "^8.20.0",
        "dotenv": "16.6.1",
        "fastify": "5.6.1",
        "pg": "^8.20.0",
        "zod": "4.1.5"
    },
    "devDependencies": {
        "@types/node": "24.4.0",
        "@vitest/coverage-v8": "^2.1.9",
        "tsx": "4.20.5",
        "typescript": "5.9.2",
        "vitest": "^2.1.9"
    }
}
