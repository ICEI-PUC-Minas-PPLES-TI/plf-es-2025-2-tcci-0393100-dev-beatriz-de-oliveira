NODE_ENV=development
HOST=0.0.0.0
PORT=3333
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
AUTH_TOKEN_SECRET=change_me_auth_secret
AUTH_ADMIN_EMAIL=admin@eletroradio.com
AUTH_ADMIN_PASSWORD=senha123
AUTH_SELLER_NAME=Vendedor
AUTH_SELLER_EMAIL=vendedor@eletroradio.com
AUTH_SELLER_PASSWORD=senha123
WHATSAPP_VERIFY_TOKEN=change_me
WHATSAPP_PROVIDER=meta
WHATSAPP_META_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
WHATSAPP_WEB_API_BASE_URL=
WHATSAPP_WEB_API_TOKEN=
WHATSAPP_WEB_API_AUTH_HEADER=Authorization
WHATSAPP_WEB_API_TIMEOUT_MS=15000
WHATSAPP_WEBHOOK_SHARED_TOKEN=
WHATSAPP_WEBHOOK_SHARED_TOKEN_HEADER=x-whatsapp-webhook-token
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_PATH=/webhooks/telegram
TELEGRAM_WEBHOOK_SECRET=

# Meta mode:
# - inbound via /webhooks/whatsapp
# - outbound via Graph API

# Web API mode:
# - outbound/session control via external whatsapp-web.js REST API
# - inbound via /webhooks/whatsapp/normalized

# Use a connection string copied directly from Supabase.
# If the database password contains special characters like @, :, / or #,
# they must be URL-encoded. Example: @ -> %40
#
# Direct connection example:
# DATABASE_URL=postgresql://postgres:your_password%40here@db.your-project-ref.supabase.co:5432/postgres?sslmode=require
#
# Pooler example (recommended when Supabase provides it):
# DATABASE_URL=postgresql://postgres.your-project-ref:your_password%40here@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:your_password%40here@db.your-project-ref.supabase.co:5432/postgres?sslmode=require
